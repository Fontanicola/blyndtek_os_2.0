{
  "source": "../audio/g6/final-voiceover.wav",
  "cues": [
    { "text": "They call them small businesses.", "source_in": 0.00, "duration": 1.76, "timeline_in": 4.20 },
    { "text": "But there is nothing small about what they carry.", "source_in": 2.02, "duration": 2.44, "timeline_in": 7.00 },
    { "text": "Before daybreak, orders move.", "source_in": 4.92, "duration": 1.90, "timeline_in": 10.20 },
    { "text": "Materials cross cities.", "source_in": 6.94, "duration": 1.42, "timeline_in": 12.40 },
    { "text": "Decisions shape everything.", "source_in": 8.70, "duration": 1.56, "timeline_in": 14.40 },
    { "text": "Yet no one can see the whole.", "source_in": 10.62, "duration": 1.86, "timeline_in": 18.20 },
    { "text": "An order becomes a message.", "source_in": 12.92, "duration": 1.72, "timeline_in": 21.00 },
    { "text": "A delay becomes a habit.", "source_in": 15.10, "duration": 1.60, "timeline_in": 23.40 },
    { "text": "A critical process becomes someone's memory.", "source_in": 16.92, "duration": 2.34, "timeline_in": 25.30 },
    { "text": "The most advanced companies build technology around their operation.", "source_in": 19.50, "duration": 3.30, "timeline_in": 27.80 },
    { "text": "Growing companies are told to work around the technology.", "source_in": 23.14, "duration": 2.78, "timeline_in": 32.10 },
    { "text": "We believe that should change.", "source_in": 26.32, "duration": 1.50, "timeline_in": 39.00 },
    { "text": "We start with the operation.", "source_in": 28.18, "duration": 1.42, "timeline_in": 41.00 },
    { "text": "We measure it.", "source_in": 30.02, "duration": 0.70, "timeline_in": 43.30 },
    { "text": "We make loss visible.", "source_in": 30.90, "duration": 1.60, "timeline_in": 44.50 },
    { "text": "Then we build around the business.", "source_in": 32.80, "duration": 1.72, "timeline_in": 46.40 },
    { "text": "Growth should not make a company harder to see.", "source_in": 34.86, "duration": 2.48, "timeline_in": 49.40 },
    { "text": "It should reveal what it can become.", "source_in": 37.62, "duration": 1.84, "timeline_in": 52.20 },
    { "text": "Blyndtek.", "source_in": 39.84, "duration": 0.60, "timeline_in": 55.20 },
    { "text": "See the company you're becoming.", "source_in": 40.78, "duration": 1.66, "timeline_in": 56.00 }
  ]
}
